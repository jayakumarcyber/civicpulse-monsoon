# CivicPulse Monsoon - Environment Template

# Project Settings
PROJECT_NAME="CivicPulse Monsoon"
ENVIRONMENT=development

# PostgreSQL / PostGIS Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse_admin
POSTGRES_PASSWORD=civicpulse_secret_key

# Backend Service
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000
